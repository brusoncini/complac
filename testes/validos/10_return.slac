# return antecipado em procedimento, em main e dentro de choose
func classifica(n: int): int
start
    choose (n)
        match 1, 2 -> return 10;
        match 3 -> return 30;
    end;
    return 0;
end

proc imprime_ate(n: int)
locvars
    i is int;
start
    i << 1;
    while (1 = 1) do
        case (i > n) return; end;
        echo(i);
        i << i + 1;
    end;
end

proc main()
locvars
    k is int;
start
    echo(classifica(2) + classifica(3) + classifica(9));
    imprime_ate(2);
    for k from 1 to 10 do
        case (k = 3) return; end;
        echo(k * 100);
    end;
    echo(-1);
end
