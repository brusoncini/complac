# case, while e repeat aninhados
proc main()
locvars
    i, j, soma is int;
start
    i << 1;
    soma << 0;
    while (i <= 3) do
        j << 0;
        repeat
            soma << soma + i;
            j << j + 1;
        until (j = 2);
        case (i = 2) echo(100); otherwise echo(i); end;
        i << i + 1;
    end;
    echo(soma);
end
