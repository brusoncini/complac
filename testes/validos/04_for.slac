# Comando for com passo e laco aninhado
proc main()
locvars
    i, j, n, total is int;
start
    n << 3;
    for i from 1 to 10 by 3 do
        echo(i);
    end;
    total << 0;
    for i from 1 to n do
        for j from i to n do
            total << total + 1;
        end;
    end;
    echo(total);
    for i from 5 to 1 do
        echo(999);
    end;
end
